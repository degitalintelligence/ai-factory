# Required secrets (set these in Coolify; do not commit real values)
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
POSTGRES_PASSWORD=

# Required model IDs from OpenRouter
LEAD_MODEL=
DEVELOPER_MODEL=
REVIEWER_MODEL=

# Optional defaults
GITHUB_OWNER=degitalintelligence
LAB_REPO=telegram-lab
MAX_ITERATIONS=3
MAX_DEV_STEPS=30
WORKSPACE_ROOT=/workspaces

# DATABASE_URL is derived automatically in docker-compose.yaml from POSTGRES_PASSWORD.
# Use a URL-safe password (recommended: random hex/alphanumeric).
