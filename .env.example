# Keep your existing V0.1 values; never paste real credentials into task requirements.
POSTGRES_PASSWORD=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
GITHUB_OWNER=degitalintelligence
LAB_REPO=telegram-lab
# Lower-cost candidate approved for a bounded live trial; quality is not certified.
# Existing deployments must explicitly update their Coolify environment values.
# Rollback: set the three roles to their previous IDs (or bunny-alpha below).
MODEL_ALIASES_JSON={"bunny-alpha":"stealth/space-bunny-alpha"}
LEAD_MODEL=openai/gpt-4.1-mini
DEVELOPER_MODEL=openai/gpt-4.1-mini
REVIEWER_MODEL=openai/gpt-4.1-mini

# Required for V0.2. Numeric IDs, comma-separated. Private chats only.
TELEGRAM_ALLOWED_USER_IDS=
# Generate independently, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
SANDBOX_TOKEN=
# Optional operator API bearer token; empty disables all /tasks endpoints.
API_TOKEN=
# Required when API_TOKEN is set. Numeric audit principal for approvals, deployments and
# memory reads made through the shared HTTP token. Startup fails closed without it.
API_OPERATOR_USER_ID=
# Optional per-role memory clearance. Values must be public|internal|confidential|restricted.
# Defaults: lead=confidential, developer=internal, reviewer=internal.
ROLE_CLEARANCE_JSON=

MAX_ITERATIONS=4
MAX_DEV_STEPS=36
MAX_DEVELOPER_STALL_STEPS=8
MAX_DEVELOPER_CONTEXT_CHARS=100000
SELF_TASK_CONTEXT_CHARS=45000
MAX_LLM_CALLS=150
MAX_TOTAL_TOKENS=600000
MAX_COST_USD=5
TASK_TIMEOUT_SECONDS=3600
# Only wheel/npm-ci dependency downloads may use network when enabled in BOTH server and project policy.
SANDBOX_INSTALL_DEPS=false
# Install the supplied runner-only AppArmor profile on Ubuntu before first deploy.
SANDBOX_APPARMOR_PROFILE=ai-factory-sandbox
# Empty defaults to lab -> GITHUB_OWNER/LAB_REPO, Python, no mandatory deployment pack.
PROJECTS_JSON=
# Example: {"lab":{"repo":"degitalintelligence/telegram-lab","profile":"python","require_deployment":true,"install_dependencies":true}}

# Optional explicit deployment to an EXISTING registered Coolify application.
COOLIFY_URL=
COOLIFY_TOKEN=
# Direct local development (Compose uses DATABASE_HOST/PASSWORD and builds the URL safely):
DATABASE_URL=sqlite+aiosqlite:///./factory.db
WORKSPACE_ROOT=./workspaces

# Register a self target in PROJECTS_JSON before enabling self-improvement execution.
# Example additional alias: "self":{"repo":"degitalintelligence/ai-factory","profile":"python"}
SELF_PROJECT=
SELF_IMPROVEMENT_ENABLED=true
TENANT_ID=default
# Tenant daily budget uses conservative token reservations for every provider attempt.
GLOBAL_MAX_LLM_CALLS_PER_DAY=1000
GLOBAL_MAX_TOKENS_PER_DAY=4000000
GLOBAL_MAX_COST_USD_PER_DAY=30
