# Keep your existing V0.1 values; never paste real credentials into task requirements.
POSTGRES_PASSWORD=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
GITHUB_OWNER=degitalintelligence
LAB_REPO=telegram-lab
LEAD_MODEL=
DEVELOPER_MODEL=
REVIEWER_MODEL=

# Required for V0.2. Numeric IDs, comma-separated. Private chats only.
TELEGRAM_ALLOWED_USER_IDS=
# Generate independently, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
SANDBOX_TOKEN=
# Optional operator API bearer token; empty disables all /tasks endpoints.
API_TOKEN=

MAX_ITERATIONS=4
MAX_DEV_STEPS=60
MAX_LLM_CALLS=150
MAX_TOTAL_TOKENS=600000
MAX_COST_USD=5
TASK_TIMEOUT_SECONDS=3600
# Only wheel/npm-ci dependency downloads may use network when enabled in BOTH server and project policy.
SANDBOX_INSTALL_DEPS=false
# Install the supplied runner-only AppArmor profile on Ubuntu before first deploy.
SANDBOX_APPARMOR_PROFILE=ai-factory-sandbox
# Empty defaults to lab -> GITHUB_OWNER/LAB_REPO, Python, no mandatory deployment pack.
PROJECTS_JSON=
# Example: {"lab":{"repo":"degitalintelligence/telegram-lab","profile":"python","require_deployment":true,"install_dependencies":true}}

# Optional explicit deployment to an EXISTING registered Coolify application.
COOLIFY_URL=
COOLIFY_TOKEN=
# Direct local development (Compose uses DATABASE_HOST/PASSWORD and builds the URL safely):
DATABASE_URL=sqlite+aiosqlite:///./factory.db
WORKSPACE_ROOT=./workspaces
